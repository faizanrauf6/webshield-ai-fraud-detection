{
  "name": "webshield-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @webshield/api\" \"npm run dev -w @webshield/web\"",
    "build": "npm run build -w @webshield/core && npm run build -w @webshield/api && npm run build -w @webshield/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/api && npm run typegen -w @webshield/web && tsc --noEmit -p apps/web",
    "test:e2e": "playwright test",
    "migrate": "npm run migrate -w @webshield/api",
    "demo-seed": "tsx scripts/seed.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:live": "tsx scripts/live-acceptance.ts",
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
